rule tabix_3:
    priority: 20
    input:
        merged_vcf = WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz"
    output:
        vcf_gz_tbi = WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz.tbi"
    threads: 1
    conda: "config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.merged_vcf}
        '''

