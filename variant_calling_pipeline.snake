####################################################################################################
########## This is a pipeline to call variants from WGS data developed by Ariel Xu #################
####################################################################################################

#INPUT_ID=["bb"]

#Libraries
import pandas as pd 

#Load configuration file
configfile: "config/config.yml"
WORKING_DIR = config["working_dir"]
RESULTS_DIR = config["results_dir"]


#Parse input samples file, extract sample ids
units = pd.read_table(config["units"], dtype=str).set_index(["path","sample"], drop=False)

#Create mappings of input read file directories to the sample ID
sample_to_path = units.set_index("sample")["path"].to_dict()

# Get list of sample IDs
INPUT_ID = list(sample_to_path.keys())

rule all:
    input:
        #expand(WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz", SAMPLE_ID = INPUT_ID)
        expand(WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_circ_variants_called_against_rCRS.vcf", SAMPLE_ID_CIRC = INPUT_ID),
        expand(WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf", SAMPLE_ID = INPUT_ID),


# convert bam files (ideally NUMT filtered chrM reads (previously aligned to chrM with bwa))
# to fq files
rule bam_2_fq:
    priority:1
    input:
        bam = lambda wildcards: f"{sample_to_path[wildcards.SAMPLE_ID]}/{wildcards.SAMPLE_ID}.bam"
    output:
        fq = WORKING_DIR + "/fq_files/{SAMPLE_ID}.fq"
    threads: 1
    conda: WORKING_DIR + "/config/samtools_ENV.yml"
    shell:
        '''
        samtools bam2fq {input.bam} > {output.fq} 
        '''   
# Add a 300bp sequence to the end of the rCRS to "circularize" it. Approach based on MitoHPC pipeline (doi:10.1093/nargab/lqac034)
rule circ_rCRS: 
    priority:2
    input:
        lin_rCRS= WORKING_DIR + "/chrM_reference/chrMref.fa",
        lin_rCRS_idx= WORKING_DIR + "/chrM_reference/chrMref.fa.fai"
    output:
        circ_rCRS= WORKING_DIR + "/chrM_reference/chrMref300.fa",
    params:
        seq_header="chrM", #header in the fasta file
        ext_len=300, #length of sequence extension
        fa_file_prefix= WORKING_DIR + "chrM_reference/chrMref" #prefix of fasta file
    conda: WORKING_DIR + "/config/samtools_ENV.yml"
    shell:
        '''
         samtools faidx {input.lin_rCRS} {params.seq_header}:1-{params.ext_len} | cat {params.fa_file_prefix}.fa - | grep -v ">" | perl -ane 'BEGIN {{ print ">{params.seq_header}\n" }}  chomp; print ; END {{ print "\n" }}'  > {output.circ_rCRS}
        '''
# Make a fasta dictionary file for the circularized rCRS sequence
rule circ_rCRS_dict: 
    priority:2
    input:
        circ_rCRS= WORKING_DIR + "/chrM_reference/chrMref300.fa"
    output:
        circ_rCRS_dict= WORKING_DIR + "/chrM_reference/chrMref300.dict"
    params:
    conda: WORKING_DIR + "/config/samtools_ENV.yml"
    shell:
        '''
         samtools dict {input.circ_rCRS} -o {output.circ_rCRS_dict}
        '''
#Generate samtools index file for circular rCRS sequence
rule circ_rCRS_samtools_idx:
    priority:3
    input:
        circ_rCRS= WORKING_DIR + "/chrM_reference/chrMref300.fa"
    output:
        circ_rCRS_fai= WORKING_DIR + "/chrM_reference/chrMref300.fa.fai"
    conda: WORKING_DIR + "/config/samtools_ENV.yml"
    shell:
        '''
        samtools faidx {input.circ_rCRS}
        '''
#Generate bwa index file for circular rCRS sequence
rule circ_rCRS_bwa_idx:
    priority:4
    input: 
        circ_rCRS= WORKING_DIR + "/chrM_reference/chrMref300.fa"
    output:
        amb = WORKING_DIR + "/chrM_reference/chrMref300.fa.amb",
        ann = WORKING_DIR + "/chrM_reference/chrMref300.fa.ann",
        bwt = WORKING_DIR + "/chrM_reference/chrMref300.fa.bwt",
        pac = WORKING_DIR + "/chrM_reference/chrMref300.fa.pac",
        sa = WORKING_DIR + "/chrM_reference/chrMref300.fa.sa"
    params:
        ext_len=300, #length of sequence extension
        fa_file_prefix= WORKING_DIR + "chrM_reference/chrMref" #prefix of fasta file
    conda: WORKING_DIR + "/config/bwa_ENV.yml"
    shell:
        '''
        bwa index {input.circ_rCRS} -p {params.fa_file_prefix}{params.ext_len}.fa 
        '''
# align fq files to linear rCRS using bwa mem
rule bwa:
    priority:5
    input:
        fq =  WORKING_DIR + "/fq_files/{SAMPLE_ID}.fq",
        amb = WORKING_DIR + "/chrM_reference/chrMref.fa.amb",
        ann = WORKING_DIR + "/chrM_reference/chrMref.fa.ann",
        bwt = WORKING_DIR + "/chrM_reference/chrMref.fa.bwt",
        pac = WORKING_DIR + "/chrM_reference/chrMref.fa.pac",
        sa = WORKING_DIR + "/chrM_reference/chrMref.fa.sa"
    output:
        sam = WORKING_DIR + "/sam_files_rCRS/{SAMPLE_ID}.sam"
    params:
        reference = WORKING_DIR + "/chrM_reference/chrMref.fa",
    threads: 1
    conda: WORKING_DIR + "/config/bwa_ENV.yml"
    shell:
        '''
        bwa mem {params.reference} {input.fq} -K 100000000 -p -v 3 -Y > {output.sam)
        '''
# align fq files to circularized rCRS using bwa mem
rule circ_bwa:
    priority:5
    input:
        fq =  WORKING_DIR + "/fq_files/{SAMPLE_ID}.fq",
        amb = WORKING_DIR + "/chrM_reference/chrMref300.fa.amb",
        ann = WORKING_DIR + "/chrM_reference/chrMref300.fa.ann",
        bwt = WORKING_DIR + "/chrM_reference/chrMref300.fa.bwt",
        pac = WORKING_DIR + "/chrM_reference/chrMref300.fa.pac",
        sa = WORKING_DIR + "/chrM_reference/chrMref300.fa.sa"
    output:
        circ_sam = WORKING_DIR + "/sam_files_rCRS/{SAMPLE_ID_CIRC}_circ.sam"
    params:
        circ_reference = WORKING_DIR + "/chrM_reference/chrMref300.fa"
    threads: 1
    conda: WORKING_DIR + "/config/bwa_ENV.yml"
    shell:
        '''
        bwa mem {params.circ_reference} {input.fq} -K 100000000 -p -v 3 -Y > {output.circ_sam}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the linear version of the rCRS
rule variant_calling_1a:
    priority:6
    input:
        sam = WORKING_DIR + "/sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        vcf = WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf",
        idx= WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.idx",
        stats= WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.stats"        
    params:
        interval = "chrM", 
        reference = WORKING_DIR + "/chrM_reference/chrMref.fa",
        working_dir = WORKING_DIR
    threads: 16
    conda: WORKING_DIR + "/config/samtools_gatk_ENV.yml"
    shell:
        '''
        bash scripts/variant_calling_1.sh {input.sam} {params.reference} {params.interval} {params.working_dir}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the circular version of the rCRS to call variants in a select region of the DLOOP with a polycytosine tract (chrM:285-315)
rule variant_calling_1b:
    priority:7
    input:
        circ_sam = WORKING_DIR + "/sam_files_rCRS/{SAMPLE_ID_CIRC}_circ.sam",
        circ_rCRS_dict= WORKING_DIR + "/chrM_reference/chrMref300.dict"
    output:
        circ_vcf = WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID_CIRC}_circ_variants_called_against_rCRS.vcf",
        circ_idx= WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID_CIRC}_circ_variants_called_against_rCRS.vcf.idx",
        circ_stats= WORKING_DIR + "/vcf_files_rCRS/{SAMPLE_ID_CIRC}_circ_variants_called_against_rCRS.vcf.stats"
    params:
        interval = "chrM:285-315",
        reference = WORKING_DIR + "/chrM_reference/chrMref300.fa",
        working_dir = WORKING_DIR
    threads: 16
    conda: WORKING_DIR + "/config/samtools_gatk_ENV.yml"
    shell:
        '''
        bash scripts/variant_calling_1.sh {input.circ_sam} {params.reference} {params.interval} {params.working_dir}
        '''
