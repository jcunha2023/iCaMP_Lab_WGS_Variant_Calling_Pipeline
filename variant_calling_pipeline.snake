####################################################################################################
########## This is a pipeline to call variants from WGS data developed by Ariel Xu #################
####################################################################################################

#INPUT_ID=["bb"]

#Libraries
import pandas as pd 

#Load configuration file
configfile: "/mtDNA_variant_call_pipeline/config/config.yml"
working_dir = config["working_dir"]
results_dir = config["results_dir"]


#Parse input samples file, extract sample ids
units = pd.read_table(config["units"], dtype=str).set_index(["sample"], drop=False)

#Create sample ID list 
INPUT_ID = units.index.get_level_values('sample').unique().tolist()

rule all:
    input:
        expand("../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus_splitted.vcf", SAMPLE_ID = INPUT_ID)

# convert bam files (ideally NUMT filtered chrM reads (previously aligned to chrM with bwa))
# to fq files
rule bam_2_fq:
    input:
        bam = "../input_bams/{SAMPLE_ID}.bam"
    output:
        fq = "../fq_files/{SAMPLE_ID}.fq"
    threads: 1
    conda: "../config/samtools_ENV.yml"
    shell:
        '''
        samtools bam2fq {input.bam} > {output.fq} 
        '''   
# Add a 300bp sequence to the end of the rCRS to "circularize" it. Approach based on MitoHPC pipeline (doi:10.1093/nargab/lqac034)
rule circ_rCRS: 
    input:
        lin_rCRS="../chrM_reference/chrMref.fa",
        lin_rCRS_idx="../chrM_reference/chrMref.fa.fai"
    output:
        circ_rCRS="../chrM_reference/chrMref300.fa",
    params:
        seq_header=chrM, #header in the fasta file
        ext_len=300, #length of sequence extension
        fa_file_prefix="../chrM_reference/chrMref" #prefix of fasta file
    conda:"../config/samtools_ENV.yml"
    shell:
        '''
        samtools faidx {input.lin_rCRS} {params.seq_header}:1-{params.ext_len} | cat {params.fa_file_prefix}.fa - | grep -v ">" |  perl -ane 'BEGIN { print ">{params.seq_header}\n" }  chomp; print ; END {print "\n"}'  > {output.circ_rCRS}
        '''
#Generate samtools index file for circular rCRS sequence
circ_rCRS_samtools_idx:
    input:
        circ_rCRS="../chrM_reference/chrMref300.fa"
    output:
        circ_rCRS_fai="../chrM_reference/chrMref300.fa.fai"
    conda: "../config/samtools_ENV.yml"
    shell:
        '''
        samtools faidx {input.circ_rCRS}
        '''
#Generate bwa index file for circular rCRS sequence
circ_rCRS_bwa_idx:
    input: 
        circ_rCRS="../chrM_reference/chrMref300.fa"
    output:
        amb = "../chrM_reference/chrMref300.amb",
        ann = "../chrM_reference/chrMref300.ann",
        bwt = "../chrM_reference/chrMref300.bwt",
        pac = "../chrM_reference/chrMref300.pac",
        sa = "../chrM_reference/chrMref300.sa"
    params:
        ext_len=300, #length of sequence extension
        fa_file_prefix="../chrM_reference/chrMref" #prefix of fasta file
    conda: "../config/bwa_ENV.yml"
    shell:
        '''
        bwa index {output.circ_rCRS} -p {params.fa_file_prefix}{params.ext_len} 
        '''
# align fq files to rCRS using bwa mem
rule bwa:
    input:
        fq =  "../fq_files/{SAMPLE_ID}.fq"
    output:
        sam = "../sam_files_rCRS/{SAMPLE_ID}.sam"
    params:
        reference ="../chrM_reference/chrMref300.fa"
    threads: 1
    conda: "../config/bwa_ENV.yml"
    shell:
        '''
        bwa mem {params.reference} {input.fq} -K 100000000 -p -v 3 -Y > {output.sam}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the linear version of the rCRS
rule variant_calling_1a:
    input:
        sam = "../sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        vcf = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 16
    conda: "../config/samtools_gatk_ENV.yml"
    shell:
        '''
        ./variant_calling_1.sh {input.sam} {params.reference}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the circular version of the rCRS
rule variant_calling_1b:
    input:
        sam = "../sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        vcf = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 16
    conda: "../config/samtools_gatk_ENV.yml"
    shell:
        '''
        ./variant_calling_1.sh {input.sam} {params.reference}
        '''
# bgzip vcf file
rule bgzip_1:
    input:
        vcf = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf"
    output:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz"
    threads: 1
    shell:
        '''
        bgzip -i {input.vcf}
        '''

# index vcf.qz file
rule tabix_1:
    input:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz"
    output:
        vcf_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_gz}
        '''

# split multiallelic variants
rule split_multiallele_1:
    input:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz",
        vcf_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi"
    output:
        vcf_splitted = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted.vcf"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 1
    conda: "../config/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk LeftAlignAndTrimVariants \
        -R {params.reference} \
        -V {input.vcf_gz} \
        -O {output.vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac
        '''

# filter for only variants with VAF > 50
rule filter_vcf_vaf_50:
    input:
        vcf_splitted = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted.vcf"
    output:
        vcf_filtered_vaf_50 = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf"
    params:
        SAMPLE_ID = INPUT_ID
    shell:
        '''
        cat {input.vcf_splitted} | grep '^#' >> {output.vcf_filtered_vaf_50}
        python3 filter_VAF.py {input.vcf_splitted} {params.SAMPLE_ID} {params.SAMPLE_ID}
        '''

# bgzip the filtered vaf > 50 vcf file
rule bgzip_2:
    input:
        vcf_filtered_vaf_50 = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf"
    output:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz"
    threads: 1
    shell:
        '''
        bgzip -i {input.vcf_filtered_vaf_50}
        '''

# index the filtered vaf > 50 vcf.gz file
rule tabix_2:
    input:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz"
    output:
        vcf_filtered_vaf_50_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_filtered_vaf_50_gz}
        '''

# use the filtered vaf > 50 vcf.gz file to make a consensus referenece based on rCRS
rule make_consensus_reference:
    input:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz",
        vcf_filtered_vaf_50_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz.tbi"
    output:
        consensus_ref = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa"
    params: 
        reference = "../chrM_reference/chrMref.fa"
    threads: 1
    conda: "../config/htslib_bcftools_ENV.yml"
    shell:
        '''
        bcftools consensus -f {params.reference} {input.vcf_filtered_vaf_50_gz} > {output.consensus_ref}
        '''
rule variant_calling_2:
    input:
        consensus_ref = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa",
        fq = "../fq_files/{SAMPLE_ID}.fq"
    output:
        vcf = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf"
    params:
    conda: "../config/variant_calling_2_ENV.yml"
    shell:
        '''
        ./variant_calling_2.sh {input.consensus_ref} {input.fq} 
        '''
        
rule bgzip_3:
    input:
        vcf = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf"
    output:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz"
    threads: 1
    conda: "../config/htslib_ENV.yml"
    shell:
        '''
        bgzip -i {input.vcf}
        '''

rule tabix_3:
    input:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz"
    output:
        vcf_gz_tbi = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_gz}
        '''

rule split_multiallele_2:
    input:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz",
        vcf_gz_tbi = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz.tbi"
    output:
        vcf_splitted = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus_splitted.vcf"
    params:
        reference = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa"
    threads: 1
    conda: "../config/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk LeftAlignAndTrimVariants \
        -R {params.reference} \
        -V {input.vcf_gz} \
        -O {output.vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac
        '''     



