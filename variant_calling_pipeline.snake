####################################################################################################
########## This is a pipeline to call variants from WGS data developed by Ariel Xu #################
####################################################################################################

#INPUT_ID=["bb"]

#Libraries
import pandas as pd 

#Load configuration file
configfile: "./config/config.yml"
working_dir = config["working_dir"]
results_dir = config["results_dir"]


#Parse input samples file, extract sample ids
units = pd.read_table(config["units"], dtype=str).set_index(["path","sample"], drop=False)

#Create mappings of input read file directories to the sample ID
sample_to_path = units.set_index("sample")["path"].to_dict()

# Get list of sample IDs
INPUT_ID = list(sample_to_path.keys())

rule all:
    input:
        #expand("./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz", SAMPLE_ID = INPUT_ID)
        expand("./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz", SAMPLE_ID = INPUT_ID)

# convert bam files (ideally NUMT filtered chrM reads (previously aligned to chrM with bwa))
# to fq files
rule bam_2_fq:
    input:
        bam = lambda wildcards: f"{sample_to_path[wildcards.SAMPLE_ID]}/{wildcards.SAMPLE_ID}.bam"
    output:
        fq = "./fq_files/{SAMPLE_ID}.fq"
    threads: 1
    conda: "./config/samtools_ENV.yml"
    shell:
        '''
        samtools bam2fq {input.bam} > {output.fq} 
        '''   
# Add a 300bp sequence to the end of the rCRS to "circularize" it. Approach based on MitoHPC pipeline (doi:10.1093/nargab/lqac034)
rule circ_rCRS: 
    input:
        lin_rCRS="./chrM_reference/chrMref.fa",
        lin_rCRS_idx="./chrM_reference/chrMref.fa.fai"
    output:
        circ_rCRS="./chrM_reference/chrMref300.fa",
    params:
        seq_header="chrM", #header in the fasta file
        ext_len=300, #length of sequence extension
        fa_file_prefix="./chrM_reference/chrMref" #prefix of fasta file
    conda:"./config/samtools_ENV.yml"
    shell:
        '''
         samtools faidx {input.lin_rCRS} {params.seq_header}:1-{params.ext_len} | cat {params.fa_file_prefix}.fa - | grep -v ">" | perl -ane 'BEGIN {{ print ">{params.seq_header}\n" }}  chomp; print ; END {{ print "\n" }}'  > {output.circ_rCRS}
        '''
#Generate samtools index file for circular rCRS sequence
rule circ_rCRS_samtools_idx:
    input:
        circ_rCRS="./chrM_reference/chrMref300.fa"
    output:
        circ_rCRS_fai="./chrM_reference/chrMref300.fa.fai"
    conda: "./config/samtools_ENV.yml"
    shell:
        '''
        samtools faidx {input.circ_rCRS}
        '''
#Generate bwa index file for circular rCRS sequence
rule circ_rCRS_bwa_idx:
    input: 
        circ_rCRS="./chrM_reference/chrMref300.fa"
    output:
        amb = "./chrM_reference/chrMref300.amb",
        ann = "./chrM_reference/chrMref300.ann",
        bwt = "./chrM_reference/chrMref300.bwt",
        pac = "./chrM_reference/chrMref300.pac",
        sa = "./chrM_reference/chrMref300.sa"
    params:
        ext_len=300, #length of sequence extension
        fa_file_prefix="./chrM_reference/chrMref" #prefix of fasta file
    conda: "./config/bwa_ENV.yml"
    shell:
        '''
        bwa index {input.circ_rCRS} -p {params.fa_file_prefix}{params.ext_len} 
        '''
# align fq files to circularized rCRS using bwa mem
rule bwa:
    input:
        fq =  "./fq_files/{SAMPLE_ID}.fq",
        amb = "./chrM_reference/chrMref300.amb",
        ann = "./chrM_reference/chrMref300.ann",
        bwt = "./chrM_reference/chrMref300.bwt",
        pac = "./chrM_reference/chrMref300.pac",
        sa = "./chrM_reference/chrMref300.sa"
    output:
        sam = "./sam_files_rCRS/{SAMPLE_ID}.sam"
    params:
        reference ="./chrM_reference/chrMref300.fa"
    threads: 1
    conda: "./config/bwa_ENV.yml"
    shell:
        '''
        bwa mem {params.reference} {input.fq} -K 100000000 -p -v 3 -Y > {output.sam}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the linear version of the rCRS
rule variant_calling_1a:
    input:
        sam = "./sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        vcf = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_lin_rCRS.vcf"
    params:
        interval = "chrM", 
        reference = "./chrM_reference/chrMref.fa"
    threads: 16
    conda: "./config/samtools_gatk_ENV.yml"
    shell:
        '''
        ./variant_calling_1.sh {input.sam} {params.reference} {params.interval}
        '''
# run variant calling script which used gatk mutect2 in mitochondrial mode
# This step uses the circular version of the rCRS to call variants in a select region of the DLOOP with a polycytosine tract (chrM:285-315)
rule variant_calling_1b:
    input:
        sam = "./sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        vcf = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf"
    params:
        interval = "chrM:285-315",
        reference = "./chrM_reference/chrMref300.fa"
    threads: 16
    conda: "./config/samtools_gatk_ENV.yml"
    shell:
        '''
        ./variant_calling_1.sh {input.sam} {params.reference} {params.interval}
        '''
# bgzip vcf file
rule bgzip_1:
    input:
        lin_vcf = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_lin_rCRS.vcf",
        circ_vcf= "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf"
    output:
        lin_vcf_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_lin_rCRS.vcf.gz",
        circ_vcf_gz= "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf.gz"  
    threads: 1
    shell:
        '''
        bgzip -i {input.lin_vcf} && bgzip -i {input.circ_vcf}
        '''

# index vcf.qz file
rule tabix_1:
    input:
        lin_vcf_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_lin_rCRS.vcf.gz",
        circ_vcf_gz= "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf.gz"  
    output:
        lin_vcf_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi",
        circ_vcf_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf.gz.tbi"   
    params:
    threads: 1
    conda: "./config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.lin_vcf_gz} && tabix -p vcf {input.circ_vcf_gz}
        '''

# split multiallelic variants
rule split_multiallele_1:
    input:
        lin_vcf_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_lin_rCRS.vcf.gz",
        circ_vcf_gz= "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf.gz",
        lin_vcf_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi",
        circ_vcf_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_circ_rCRS.vcf.gz.tbi"   
    output:
        lin_vcf_splitted = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_lin.vcf",
        circ_vcf_splitted = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_circ.vcf"
    params:
        lin_reference = "./chrM_reference/chrMref.fa",
        circ_reference = "./chrM_reference/chrMref300.fa"
    threads: 1
    conda: "./config/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk LeftAlignAndTrimVariants \
        -R {params.lin_reference} \
        -V {input.lin_vcf_gz} \
        -O {output.lin_vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac && \

        gatk LeftAlignAndTrimVariants \
        -R {params.circ_reference} \
        -V {input.circ_vcf_gz} \
        -O {output.circ_vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac 
        '''

# filter for only variants with VAF > 50
rule filter_vcf_vaf_50:
    input:
        lin_vcf_splitted = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_lin.vcf",
        circ_vcf_splitted = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_circ.vcf"
    output:
        lin_vcf_filtered_vaf_50 = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf",
        circ_vcf_filtered_vaf_50 = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf"
    params:
        SAMPLE_ID = INPUT_ID
    shell:
        '''
        cat {input.lin_vcf_splitted} | grep '^#' >> {output.lin_vcf_filtered_vaf_50}
        python3 filter_VAF.py {input.lin_vcf_splitted} {params.SAMPLE_ID} {params.SAMPLE_ID} && \

        cat {input.circ_vcf_splitted} | grep '^#' >> {output.circ_vcf_filtered_vaf_50}
        python3 filter_VAF.py {input.circ_vcf_splitted} {params.SAMPLE_ID} {params.SAMPLE_ID} && \
        '''

# bgzip the filtered vaf > 50 vcf files
rule bgzip_2:
    input:
        lin_vcf_filtered_vaf_50 = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf",
        circ_vcf_filtered_vaf_50 = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf"
    output:
        lin_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf.gz",
        circ_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf.gz"
    threads: 1
    shell:
        '''
        bgzip -i {input.lin_vcf_filtered_vaf_50} && \
        bgzip -i {input.circ_vcf_filtered_vaf_50}
        '''

# index the filtered vaf > 50 vcf.gz file
rule tabix_2:
    input:
        lin_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf.gz",
        circ_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf.gz"
    output:
        lin_vcf_filtered_vaf_50_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf.gz.tbi",
        circ_vcf_filtered_vaf_50_gz_tbi = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf.gz.tbi"
    threads: 1
    conda: "./config/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.lin_vcf_filtered_vaf_50_gz} && \
        tabix -p vcf {input.circ_vcf_filtered_vaf_50_gz} && \
        '''
#Merge filtered VAF > 50 vcf files into a single file

rule merge_vcf_1:
    input:
        lin_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_lin.vcf.gz",
        circ_vcf_filtered_vaf_50_gz = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_circ.vcf.gz"
    output:
        merged_vcf = "./vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered_merged.vcf.gz"
    threads: 1
    conda: "./config/htslib_bcftools_ENV.yml"
    shell:
        '''
        bcftools merge --force-samples -Oz -o {output.merged_vcf} {input.lin_vcf_filtered_vaf_50_gz} {input.circ_vcf_filtered_vaf_50_gz}
        '''

