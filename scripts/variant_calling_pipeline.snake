#######################################################################################################################################
########## This is a pipeline to call variants from WGS data developed by Ariel Xu, Nathaniel Fisher, and Jason Cunha #################
#######################################################################################################################################

# Import Python libraries
import os 

### UPDATE THIS EVERY TIME BASED ON FULL EXTENSION ###
# modify this based on location of BAMs
BAM_DIR="/restricted/projectnb/icamp/gtex/blood_WGS/2025_WGS_Calling_NOT_NUMT_Filtered/testing/"
BAM_EXTENSION="_no_NUMT_reads.bam"

# Get all bam files
bam_files = []
for file in os.listdir(BAM_DIR):
    if file.endswith(BAM_EXTENSION):
        bam_files.append(file)

# Get all sample IDS
INPUT_ID = [val.replace(BAM_EXTENSION,"") for val in bam_files]
rule all:
    input:
        expand("../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus_splitted.vcf", SAMPLE_ID = INPUT_ID)
        
#Convert bam files (ideally NUMT filtered chrM reads (previously aligned to chrM with bwa)) to fq files, but first sort by read name for alignment of paired reads
rule bam_2_fq:
    input:
        bam = lambda wildcards: f"{BAM_DIR}{wildcards.SAMPLE_ID}{BAM_EXTENSION}"
    output:
        fq = "../fq_files/{SAMPLE_ID}.fq"
    threads: 1
    conda: "../envs/samtools_ENV.yml"
    shell:
        '''
        samtools sort -n {input.bam} | samtools bam2fq  > {output.fq} 
        '''    

# Align fq files to rCRS using bwa mem
rule bwa:
    input:
        fq =  "../fq_files/{SAMPLE_ID}.fq"
    output:
        sam = "../sam_files_rCRS/{SAMPLE_ID}.sam"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 1
    conda: "../envs/samtools_gatk_bwa_ENV.yml"
    shell:
        '''
        bwa mem {params.reference} {input.fq} -K 100000000 -p -v 3 -Y | samtools sort -o {output.sam}
        '''


# Mark duplicate reads 
rule mark_duplicates_1:
    input:
        sam = "../sam_files_rCRS/{SAMPLE_ID}.sam"
    output:
        sam_dups_marked = "../sam_files_rCRS/{SAMPLE_ID}_duplicates_marked.sam",
        marked_dups_file = "../marked_duplicate_stats/{SAMPLE_ID}_duplicate_stats_rCRS.txt"
    params:
    threads: 1
    conda: "../envs/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk MarkDuplicates -I {input.sam} -O {output.sam_dups_marked} -M {output.marked_dups_file}
        '''

# Run variant calling script which used gatk mutect2 in mitochondrial mode
rule variant_calling_1:
    input:
        sam_dups_marked = "../sam_files_rCRS/{SAMPLE_ID}_duplicates_marked.sam"
    output:
        vcf = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 4
    conda: "../envs/samtools_gatk_ENV.yml"
    shell:
        '''
        ./variant_calling_1.sh {input.sam_dups_marked} {params.reference}
        '''

# Bgzip vcf file
rule bgzip_1:
    input:
        vcf = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf"
    output:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz"
    threads: 1
    conda: "../envs/htslib_ENV.yml"
    shell:
        '''
        bgzip -i {input.vcf}
        '''

# Index vcf.qz file
rule tabix_1:
    input:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz"
    output:
        vcf_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../envs/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_gz}
        '''

# Split multiallelic variants
rule split_multiallele_1:
    input:
        vcf_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz",
        vcf_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS.vcf.gz.tbi"
    output:
        vcf_splitted = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted.vcf"
    params:
        reference = "../chrM_reference/chrMref.fa"
    threads: 1
    conda: "../envs/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk LeftAlignAndTrimVariants \
        -R {params.reference} \
        -V {input.vcf_gz} \
        -O {output.vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac
        '''

# Filter for only variants with VAF > 50
rule filter_vcf_vaf_50:
    input:
        vcf_splitted = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted.vcf"
    output:
        vcf_filtered_vaf_50 = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf"
    params:
        SAMPLE_ID = "{SAMPLE_ID}"
    shell:
        '''
        cat {input.vcf_splitted} | grep '^#' >> {output.vcf_filtered_vaf_50}
        python3 filter_VAF.py {input.vcf_splitted} {params.SAMPLE_ID} {params.SAMPLE_ID}
        '''

# Bgzip the filtered vaf > 50 vcf file
rule bgzip_2:
    input:
        vcf_filtered_vaf_50 = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf"
    output:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz"
    threads: 1
    conda: "../envs/htslib_ENV.yml"
    shell:
        '''
        bgzip -i {input.vcf_filtered_vaf_50}
        '''

# Index the filtered vaf > 50 vcf.gz file
rule tabix_2:
    input:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz"
    output:
        vcf_filtered_vaf_50_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../envs/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_filtered_vaf_50_gz}
        '''

# Use the filtered vaf > 50 vcf.gz file to make a consensus reference based on rCRS
rule make_consensus_reference:
    input:
        vcf_filtered_vaf_50_gz = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz",
        vcf_filtered_vaf_50_gz_tbi = "../vcf_files_rCRS/{SAMPLE_ID}_variants_called_against_rCRS_splitted_filtered.vcf.gz.tbi"
    output:
        consensus_ref = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa"
    params: 
        reference = "../chrM_reference/chrMref.fa"
    threads: 1
    conda: "../envs/htslib_bcftools_ENV.yml"
    shell:
        '''
        bcftools consensus -f {params.reference} {input.vcf_filtered_vaf_50_gz} > {output.consensus_ref}
        '''

# Complete second step of variant valling        
rule variant_calling_2:
    input:
        consensus_ref = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa",
        fq = "../fq_files/{SAMPLE_ID}.fq"
    output:
        vcf = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf"
    threads: 4
    conda: "../envs/samtools_gatk_bwa_ENV.yml"
    shell:
        '''
        ./variant_calling_2.sh {input.consensus_ref} {input.fq} 
        '''
        
# Bgzip vcf output
rule bgzip_3:
    input:
        vcf = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf"
    output:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz"
    threads: 1
    conda: "../envs/htslib_ENV.yml"
    shell:
        '''
        bgzip -i {input.vcf}
        '''

# Index vcf output
rule tabix_3:
    input:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz"
    output:
        vcf_gz_tbi = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz.tbi"
    params:
    threads: 1
    conda: "../envs/samtools_ENV.yml"
    shell:
        '''         
        tabix -p vcf {input.vcf_gz}
        '''
        
# Split multuallelic sites
rule split_multiallele_2:
    input:
        vcf_gz = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz",
        vcf_gz_tbi = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus.vcf.gz.tbi"
    output:
        vcf_splitted = "../vcf_files_consensus/{SAMPLE_ID}_variants_called_against_consensus_splitted.vcf"
    params:
        reference = "../consensus_reference_sequences/{SAMPLE_ID}_consensus_ref.fa"
    threads: 1
    conda: "../envs/samtools_gatk_ENV.yml"
    shell:
        '''
        gatk LeftAlignAndTrimVariants \
        -R {params.reference} \
        -V {input.vcf_gz} \
        -O {output.vcf_splitted} \
        --split-multi-allelics \
        --keep-original-ac
        '''     

